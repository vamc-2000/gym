generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  email    String  @unique
  password String
  role     Role    @default(USER)
  gender   String?

  height           Float?
  weight           Float?
  targetWeight     Float?
  bmi              Float?
  bmiCategory      String?
  bodyFat          Float?
  goal             String?
  fitnessLevel     String?
  dietPreference   String?   @default("BOTH") // VEG, NON_VEG, BOTH
  otp              String?
  otpExpiry        DateTime?
  refreshToken     String?
  lastLogin        DateTime?
  workoutStartDate DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  notificationSettings NotificationSettings?
  streaks              Streak?
  workoutLogs          WorkoutLog[]
  progress             Progress[]
  leaderboard          Leaderboard?
  dailyLeaderboard     DailyLeaderboard?
  dietLogs             Diet[]
  notifications        Notification[]
  scheduleItems        ScheduleItem[]
  assignedWorkouts     AssignedWorkout[]
  assignedDiets        AssignedDiet[]
  userPlan             UserPlan?
  workoutHistory       WorkoutHistory[]

  // Community & Social
  posts            CommunityPost[]
  likes            PostLike[]
  comments         PostComment[]
  sentRequests     Friendship[]      @relation("SentRequests")
  receivedRequests Friendship[]      @relation("ReceivedRequests")
  sentMessages     ChatMessage[]     @relation("SentMessages")
  receivedMessages ChatMessage[]     @relation("ReceivedMessages")

  // Email & Security
  resetTokens  PasswordResetToken[]
  sentEmails   EmailLog[]
}

model UserPlan {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @unique @db.ObjectId
  user            User      @relation(fields: [userId], references: [id])
  goal            String
  fitnessLevel    String
  workoutPlan     Json
  dietPlan        Json?
  currentDay      Int       @default(1)
  totalDays       Int       @default(30)
  completedDays   Json?
  lastCompletedAt DateTime?
  completedDate   String?
  bmi             Float?
  bmiCategory     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model WorkoutHistory {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  userId                String   @db.ObjectId
  user                  User     @relation(fields: [userId], references: [id])
  workoutDayNumber      Int
  planCycleDay          Int
  goal                  String
  workoutTitle          String
  bodyPartFocus         String
  exercisesCompleted    Json
  totalExercises        Int
  durationSeconds       Int
  durationFormatted     String
  caloriesBurned        Int
  startedAt             DateTime
  completedAt           DateTime
  completedDate         String
  streakAfterCompletion Int
  createdAt             DateTime @default(now())

  @@index([userId])
  @@index([completedDate])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

type NotificationSettings {
  preferredWorkoutTime String  @default("07:00")
  dndEnabled           Boolean @default(false)
  dndStart             String  @default("22:00")
  dndEnd               String  @default("06:00")

  // Notification Preferences by Category
  workoutReminders   Boolean @default(true)
  goalProgress       Boolean @default(true)
  nutritionHydration Boolean @default(true)
  recoveryHealth     Boolean @default(true)
  socialCommunity    Boolean @default(true)
  marketingPromos    Boolean @default(false)
}

model Streak {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @unique @db.ObjectId
  user            User      @relation(fields: [userId], references: [id])
  currentStreak   Int       @default(0)
  longestStreak   Int       @default(0)
  lastWorkoutDate DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model WorkoutLog {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  userId          String          @db.ObjectId
  user            User            @relation(fields: [userId], references: [id])
  workoutId       String          @db.ObjectId
  workout         AssignedWorkout @relation(fields: [workoutId], references: [id])
  date            DateTime        @default(now())
  completed       Boolean         @default(false)
  startTime       DateTime?
  endTime         DateTime?
  durationSeconds Int?
  caloriesBurned  Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model WorkoutTemplate {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  goal      String
  level     String
  exercises Json // Standardized template
  isActive  Boolean  @default(false)
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AssignedWorkout {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  userId      String       @db.ObjectId
  user        User         @relation(fields: [userId], references: [id])
  templateId  String?      @db.ObjectId // Reference to original template if needed
  title       String
  goal        String
  level       String
  exercises   Json // Snapshot of exercises at time of assignment
  assignedAt  DateTime     @default(now())
  isActive    Boolean      @default(true)
  workoutLogs WorkoutLog[]

  @@index([userId, isActive])
}

model ExerciseLibrary {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String   @unique
  category     String // "Strength", "Cardio", "Flexibility"
  muscleGroup  String[] // ["Chest", "Triceps"]
  equipment    String[] // ["Dumbbells", "Bench"]
  instructions String?
  videoUrl     String?
  imageUrl     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Removed Exercise type as it's now part of weeklyPlan Json

model Progress {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  weight    Float?
  note      String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Leaderboard {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @unique @db.ObjectId
  user        User     @relation(fields: [userId], references: [id])
  category    String   @default("Overall")
  rank        Int?
  score       Int      @default(0)
  lastUpdated DateTime @default(now())
}

model DailyLeaderboard {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @unique @db.ObjectId
  user        User     @relation(fields: [userId], references: [id])
  date        DateTime @default(now())
  rank        Int?
  score       Int      @default(0)
  workouts    Int      @default(0)
  duration    Int      @default(0)
  calories    Int      @default(0)
  lastUpdated DateTime @default(now())
}

model ScheduleItem {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  type        String // "workout", "meal", "water", "sleep", "supplement", "custom"
  time        String // HH:MM format (24h)
  status      String   @default("upcoming") // "upcoming", "active", "completed", "missed"
  date        DateTime @default(now()) // The specific calendar date this item belongs to
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, date, title, time])
}

model Diet {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  date      DateTime @default(now())
  calories  Int      @default(0)
  protein   Int      @default(0)
  carbs     Int      @default(0)
  fats      Int      @default(0)
  logs      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DietTemplate {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  goal          String
  level         String
  planName      String
  description   String
  dietType      String   @default("BOTH") // VEG, NON_VEG, BOTH
  calorieTarget String // e.g., "maintenance", "surplus"
  proteinPerKg  Float
  meals         Json // Stores meal schedule
  minBMI        Float?
  maxBMI        Float?
  isActive      Boolean  @default(false)
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AssignedDiet {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @db.ObjectId
  user          User     @relation(fields: [userId], references: [id])
  templateId    String?  @db.ObjectId // Reference to original template
  goal          String
  level         String
  planName      String
  description   String
  dietType      String   @default("BOTH")
  calorieTarget String
  proteinPerKg  Float
  meals         Json // Snapshot of meal schedule at time of assignment
  assignedAt    DateTime @default(now())
  isActive      Boolean  @default(true)

  @@index([userId, isActive])
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  read      Boolean  @default(false)
  type      String? // Event name like 'workout.scheduled.reminder'
  category  String? // Category like 'WORKOUT', 'GOALS', 'NUTRITION', etc.
  priority  String   @default("LOW") // 'CRITICAL', 'HIGH', 'MEDIUM', 'LOW'
  metadata  Json? // Optional payload (e.g., linked resource IDs)
  createdAt DateTime @default(now())

  @@index([userId])
}

model LeaderboardSnapshot {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  category      String
  rankings      Json
  weekStartDate DateTime
  createdAt     DateTime @default(now())
}

model SystemSettings {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  registrationsEnabled  Boolean  @default(true)
  adminApprovalRequired Boolean  @default(false)
  userEditWorkoutPlan   Boolean  @default(true)
  userEditDietPlan      Boolean  @default(true)
  notificationsEnabled  Boolean  @default(true)
  updatedAt             DateTime @updatedAt
}

model AdminLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  adminId   String   @db.ObjectId
  action    String
  target    String?
  details   String?
  createdAt DateTime @default(now())
}

// --- Community Module ---

model CommunityPost {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  userId        String      @db.ObjectId
  user          User        @relation(fields: [userId], references: [id])
  content       String
  mediaUrl      String?
  mediaType     MediaType   @default(TEXT)
  privacy       PostPrivacy @default(PUBLIC)
  likesCount    Int         @default(0)
  commentsCount Int         @default(0)
  likes         PostLike[]
  comments      PostComment[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId])
  @@index([privacy])
}

model PostLike {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  postId    String   @db.ObjectId
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model PostComment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  postId    String   @db.ObjectId
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime @default(now())

  @@index([postId])
}

model Friendship {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  userId    String           @db.ObjectId
  friendId  String           @db.ObjectId
  status    FriendshipStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user      User             @relation("SentRequests", fields: [userId], references: [id])
  friend    User             @relation("ReceivedRequests", fields: [friendId], references: [id])

  @@unique([userId, friendId])
}

model ChatMessage {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  senderId   String   @db.ObjectId
  receiverId String   @db.ObjectId
  message    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
}

enum PostPrivacy {
  PUBLIC
  PRIVATE
}

enum MediaType {
  IMAGE
  VIDEO
  TEXT
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

model PasswordResetToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  otp       String
  token     String?
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([email])
}

model EmailLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  senderId    String   @db.ObjectId
  sender      User     @relation(fields: [senderId], references: [id])
  audience    String   // "ALL", "ADMINS", "SELECTED"
  subject     String
  message     String
  status      String   // "SENT", "FAILED"
  sentCount   Int      @default(0)
  failedCount Int      @default(0)
  createdAt   DateTime @default(now())
}
